+// ---- TEMPORARY key-corpus instrumentation (X1); never committed ----
+pub fn keydump(kind: &str, text: &str) {
+    use std::collections::HashSet;
+    use std::io::Write;
+    use std::sync::{Mutex, OnceLock};
+    static SINK: OnceLock<Option<Mutex<(std::fs::File, HashSet<String>)>>> = OnceLock::new();
+    let sink = SINK.get_or_init(|| {
+        let path = std::env::var("TI4_KEYDUMP").ok()?;
+        let file = std::fs::OpenOptions::new().create(true).append(true).open(path).ok()?;
+        Some(Mutex::new((file, HashSet::new())))
+    });
+    if let Some(m) = sink {
+        let mut g = m.lock().unwrap();
+        let line = format!("{kind}\t{text:?}\n");
+        if g.1.insert(line.clone()) {
+            let _ = g.0.write_all(line.as_bytes());
+        }
+    }
+}
+#[derive(Clone, Default, PartialEq, Eq, Debug)]
+pub struct Marks(pub BTreeMap<String, String>);
+impl std::ops::Deref for Marks { type Target = BTreeMap<String, String>; fn deref(&self) -> &Self::Target { &self.0 } }
+impl std::ops::DerefMut for Marks { fn deref_mut(&mut self) -> &mut Self::Target { &mut self.0 } }
+impl Marks {
+    pub fn is_empty(&self) -> bool { self.0.is_empty() }
+    pub fn insert(&mut self, k: String, v: String) -> Option<String> {
+        keydump("mark_key", &k); keydump("mark_val", &format!("{k}\u{1}{v}"));
+        self.0.insert(k, v)
+    }
+    pub fn extend<I: IntoIterator<Item = (String, String)>>(&mut self, it: I) {
+        for (k, v) in it { self.insert(k, v); }
+    }
+}
+impl Serialize for Marks { fn serialize<S: serde::Serializer>(&self, s: S) -> Result<S::Ok, S::Error> { self.0.serialize(s) } }
+impl<'de> Deserialize<'de> for Marks {
+    fn deserialize<D: serde::Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
+        let m = BTreeMap::<String, String>::deserialize(d)?;
+        let mut out = Marks::default();
+        out.extend(m);
+        Ok(out)
+    }
+}
